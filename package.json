{
  "name": "jovi-styles",
  "version": "0.1.0",
  "description": "Portable React Native theming package",
  "main": "src/index.ts",
  "react-native": "dist/index.js",
  "types": "dist/index.d.ts",
  "source": "src/index.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-safe-area-context": ">=4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react-native": "^0.84.1",
    "react-native-safe-area-context": "^5.7.0",
    "typescript": "^5.8.3"
  }
}
